{
	"name": "pi-agent-host",
	"version": "0.1.0",
	"description": "Agent Host Protocol server for the pi coding agent",
	"type": "module",
	"license": "Apache-2.0",
	"bin": {
		"pi-agent-host": "./dist/bin/pi-agent-host.js"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
		"test": "node --test --test-timeout=60000 'test/**/*.test.ts'",
		"start": "node src/bin/pi-agent-host.ts",
		"prepack": "npm run build"
	},
	"engines": {
		"node": ">=24"
	},
	"dependencies": {
		"@earendil-works/pi-coding-agent": "^1.0.1",
		"@lydell/node-pty": "^1.2.0-beta.15",
		"@microsoft/agent-host-protocol": "^1.0.0",
		"@parcel/watcher": "^2.6.0",
		"ws": "^8.22.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@earendil-works/pi-ai": "^1.0.1",
		"@types/node": "^26.6.4",
		"@types/ws": "^8.18.2",
		"typescript": "^7.0.2"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"keywords": [
		"pi",
		"agent-host-protocol",
		"ahp",
		"vscode"
	]
}
